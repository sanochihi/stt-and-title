# Database (PostgreSQL)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SCHEMA=game

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1

# S3
S3_BUCKET_NAME=
S3_AUDIO_PREFIX=audio/incoming/
S3_PROCESSING_PREFIX=audio/processing/
S3_PROCESSED_PREFIX=audio/processed/

# Amazon Transcribe
TRANSCRIBE_LANGUAGE_CODE=ja-JP

# Amazon Bedrock (Claude Haiku)
# ap-northeast-1 利用時の例（リージョンに合わせて Bedrock コンソールの inference profile ID を指定）
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# App
POLL_INTERVAL_SECONDS=10
LOG_FILE=app.log
# 並列度（Transcribe / Bedrock はそれぞれ同時実行数の上限）
MAX_CONCURRENT_TRANSCRIBE=3
MAX_CONCURRENT_BEDROCK=5
MAX_WORKER_THREADS=8
